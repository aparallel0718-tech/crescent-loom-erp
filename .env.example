# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crescent-loom-erp

# NextAuth
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Used once by the seed script to create the first admin user
SEED_ADMIN_EMAIL=you@crescentloom.com
SEED_ADMIN_PASSWORD=change-me-immediately
SEED_ADMIN_NAME=Raghav
